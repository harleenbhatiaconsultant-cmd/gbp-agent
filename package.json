    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.9.1",
    "shadcn": "^4.18.0",
