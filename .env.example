# ==============================================================================
# GBP Growth Agent — environment template
#
# Copy to `.env.local` (Next.js) / `.env` (Prisma + worker) and fill in.
# NEVER commit a filled-in file. Only this template is tracked.
#
# Legend:
#   [REQUIRED]      app will not boot without it
#   [PHASE n]       not needed until that development phase
#   [GOOGLE CLOUD]  requires configuration in the Google Cloud Console
#   [EXTERNAL]      requires a paid or approved third-party account
#
# Every variable here is SERVER-ONLY except those prefixed NEXT_PUBLIC_.
# Anything prefixed NEXT_PUBLIC_ is shipped to the browser — never put a secret there.
# ==============================================================================


# ------------------------------------------------------------------------------
# Core application
# ------------------------------------------------------------------------------
NODE_ENV=development                                  # [REQUIRED] development | test | production
APP_URL=http://localhost:3000                         # [REQUIRED] canonical server-side base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000             # [REQUIRED] same value, exposed to the browser
LOG_LEVEL=debug                                       # trace | debug | info | warn | error


# ------------------------------------------------------------------------------
# Database — PostgreSQL
# A local Postgres 16 is already running on this machine:
#   binaries: C:\Users\HP\pgportable\pgsql\bin    data: C:\Users\HP\pgdata    port: 5432
# Create the database first:
#   C:\Users\HP\pgportable\pgsql\bin\createdb.exe -U postgres gbp_growth_agent
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/gbp_growth_agent?schema=public   # [REQUIRED]

# Only needed if you later move to a pooled host (PgBouncer, Neon, Supabase).
# Prisma migrations must use a direct, unpooled connection.
DIRECT_URL=


# ------------------------------------------------------------------------------
# Redis — background jobs (BullMQ)  [PHASE 4]
# Not installed locally. Use a managed Redis (Upstash), Memurai, or Redis under WSL2.
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=gbp
WORKER_CONCURRENCY=5


# ------------------------------------------------------------------------------
# Session / auth  [PHASE 1]
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ------------------------------------------------------------------------------
AUTH_SECRET=                                          # [REQUIRED] 32+ random bytes, base64
AUTH_URL=http://localhost:3000                        # Auth.js callback base
AUTH_TRUST_HOST=true                                  # true in local dev only

# Google sign-in (login only — this is NOT the profile-management consent).
# [GOOGLE CLOUD] OAuth 2.0 Client ID, type "Web application".
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=


# ------------------------------------------------------------------------------
# Google Business Profile OAuth  [PHASE 2] [GOOGLE CLOUD]
#
# A SEPARATE OAuth client and consent from login above. Signing in must not
# silently grant write access to a customer's business profile.
# Authorized redirect URI: {APP_URL}/api/google/oauth/callback
# The consent screen must declare the business.manage scope; that scope requires
# Google verification before a public (non-test-user) launch.
# ------------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/oauth/callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/business.manage

# Google Cloud project hosting the enabled Business Profile APIs.
GOOGLE_CLOUD_PROJECT_ID=

# API host overrides — set only if Google changes an endpoint. Defaults are compiled in.
#   Account Management:   mybusinessaccountmanagement.googleapis.com
#   Business Information: mybusinessbusinessinformation.googleapis.com
#   Performance:          businessprofileperformance.googleapis.com
#   Notifications:        mybusinessnotifications.googleapis.com
#   Verifications:        mybusinessverifications.googleapis.com
#   Reviews + Local Posts: mybusiness.googleapis.com  (legacy v4.9 — NOT migrated to v1)


# ------------------------------------------------------------------------------
# GBP write safety  [PHASE 6]
#
# validate_only  -> every write goes to Google with validateOnly=true. Nothing changes.
# live           -> real profile mutations. Requires an APPROVED GBP API access request.
#
# There is no Google sandbox. Keep this on validate_only outside production.
# ------------------------------------------------------------------------------
GBP_WRITE_MODE=validate_only                          # validate_only | live
GBP_MAX_EDITS_PER_MINUTE=10                           # per profile — Google's Business Information limit
GBP_MAX_QPM=300                                       # global default quota once access is approved
GBP_MAX_CHANGES_PER_LOCATION_PER_DAY=10               # our own blast-radius cap


# ------------------------------------------------------------------------------
# Token encryption at rest  [PHASE 2] [REQUIRED once connections exist]
#
# AES-256-GCM key for OAuth refresh tokens. 32 bytes, base64.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Losing this key makes every stored connection unrecoverable — customers must reconnect.
# Rotate by adding a new key with a higher version and re-encrypting in the background.
# ------------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1


# ------------------------------------------------------------------------------
# Google Cloud Pub/Sub — review notifications  [PHASE 7] [GOOGLE CLOUD]
# Optional: polling is the fallback, so the product works without this.
# ------------------------------------------------------------------------------
GBP_PUBSUB_TOPIC=                                     # projects/{project}/topics/{topic}
GBP_PUBSUB_PUSH_AUDIENCE=                             # expected OIDC audience on the push request
GBP_PUBSUB_VERIFICATION_TOKEN=                        # shared secret on the push subscription URL
GOOGLE_APPLICATION_CREDENTIALS=                       # path to the service-account JSON key


# ------------------------------------------------------------------------------
# AI provider  [PHASE 5/6]
#
# The provider is abstracted behind an interface — switching providers is a config
# change plus one adapter, not a rewrite. The LLM never executes API mutations;
# it only proposes payloads that must pass schema validation, policy checks and approval.
# ------------------------------------------------------------------------------
AI_PROVIDER=anthropic                                 # anthropic | openai

# Anthropic (default)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5                         # reasoning: recommendations, review responses, report narrative
ANTHROPIC_FAST_MODEL=claude-haiku-4-5                 # high-volume: review sentiment + topic classification

# OpenAI (alternate adapter — leave blank unless AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=

# Cost controls. On breach, the platform degrades to rule-only recommendations
# rather than failing the audit.
AI_MONTHLY_BUDGET_USD=100
AI_REQUEST_TIMEOUT_MS=60000


# ------------------------------------------------------------------------------
# Local rank tracking  [PHASE 10] [EXTERNAL]
#
# Google has NO first-party endpoint for local pack position, and scraping Google
# SERPs directly violates its Terms of Service. Rank data must come from a licensed
# provider. This is a metered cost centre — scans are scheduled by plan tier.
# ------------------------------------------------------------------------------
RANK_PROVIDER=dataforseo                              # dataforseo | serpapi | none
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_KEY=
RANK_GRID_DEFAULT_SIZE=7                              # 7 => 7x7 = 49 sample points per scan
RANK_GRID_DEFAULT_RADIUS_M=5000
RANK_SCAN_MAX_PER_DAY=50                              # spend guard


# ------------------------------------------------------------------------------
# Website audit crawler  [PHASE 11]
# ------------------------------------------------------------------------------
CRAWLER_USER_AGENT=GBPGrowthAgentBot/1.0 (+https://example.com/bot)
CRAWLER_MAX_PAGES=200
CRAWLER_TIMEOUT_MS=15000
CRAWLER_CONCURRENCY=3
CRAWLER_RESPECT_ROBOTS=true                           # keep true

# Optional enrichment [GOOGLE CLOUD]
PAGESPEED_API_KEY=
GOOGLE_SEARCH_CONSOLE_ENABLED=false


# ------------------------------------------------------------------------------
# Competitor monitoring  [PHASE 11] [GOOGLE CLOUD]
# Note: the Places API Terms restrict caching/storage of Places data. Store only
# what is permitted and refresh rather than archive indefinitely.
# ------------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=


# ------------------------------------------------------------------------------
# Email & notifications  [PHASE 8+]
# ------------------------------------------------------------------------------
EMAIL_FROM=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SLACK_WEBHOOK_URL=


# ------------------------------------------------------------------------------
# Billing  [PHASE 14] [EXTERNAL]
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_AGENCY=


# ------------------------------------------------------------------------------
# Observability
# ------------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=development


# ------------------------------------------------------------------------------
# Scheduler auth
# Shared secret for the authenticated /api/cron/[job] trigger, if an external
# scheduler is used instead of in-worker repeatable jobs.
# ------------------------------------------------------------------------------
CRON_SECRET=


# ------------------------------------------------------------------------------
# Feature flags
#
# ENABLE_AUTO_APPLY is the master switch for unattended profile changes.
# It stays FALSE by default, and is additionally opt-in per organization AND per
# action type. High-risk actions (business name, primary category) always require
# a human approver regardless of this flag.
# ------------------------------------------------------------------------------
ENABLE_AUTO_APPLY=false
ENABLE_POSTS=false
ENABLE_RANK_TRACKING=false
ENABLE_COMPETITORS=false
ENABLE_WEBSITE_AUDIT=false
ENABLE_REPORTS=false
ENABLE_WHITE_LABEL=false
ENABLE_BILLING=false
